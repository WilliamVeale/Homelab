    {
      "id": 7,
      "type": "timeseries",
      "title": "Power",
      "description": "The UPS reports load in steps of 1%. One step is 10 W. The 1 h average shows smaller changes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "network_ups_tools_ups_load * network_ups_tools_ups_realpower_nominal / 100",
          "legendFormat": "Power",
          "refId": "A",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg_over_time(network_ups_tools_ups_load[1h]) * network_ups_tools_ups_realpower_nominal / 100",
          "legendFormat": "1 h average",
          "refId": "B",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear"
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Power"
            },
            "properties": [
              {
                "id": "custom.lineInterpolation",
                "value": "stepAfter"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "1 h average"
            },
            "properties": [
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
